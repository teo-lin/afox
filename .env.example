# Copy to .env and edit. This key is optional — the default works.
# fleet.sh `source`s this file, so always quote: a bare path containing a space
# is parsed as a command and the line fails.
#
# There is no FLEET_REPO here on purpose: roles.yml hard-codes `repo: .`, the
# invoking directory, so panes can never silently reopen in a stale repo from
# a past session. To target a different repo for one run, pass it as an
# explicit argument instead: `fleet <session> <repo-path>`.

# Claude config dir, passed explicitly because panes run via `sh -c` and never
# load .zshrc. Default: ~/.claude. Point it elsewhere if that is not where your
# credentials and folder-trust records live.
CLAUDE_CONFIG_DIR="~/.claude"
